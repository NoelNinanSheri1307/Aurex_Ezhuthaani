# ==============================================================================
# Ezhuthaani Root .gitignore
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
*/venv/
*/.venv/

# Python Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
scratch/

# Databases & Local Persistence
*.db
*.sqlite
*.sqlite3
dev.db
backend/dev.db

# Large Neural TTS Models & Audio Test Files (Too large for GitHub)
*.onnx
*.onnx.json
*.wav
tts-models/**/*.onnx
tts-models/**/*.onnx.json
!**/ttsinstructions.md

# Node.js & Next.js Build Outputs
node_modules/
.next/
out/
build/
dist/
.turbo/

# Package Manager Logs & System Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Environment Files & Secrets (Never commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
!.env.example
!*/.env.example

# Deployment Platforms & IDEs
.vercel/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Agent Brain Scratch & Logs
.gemini/
brain/
tmp/
