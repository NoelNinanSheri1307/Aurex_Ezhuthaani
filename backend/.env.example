# Database connection string (PostgreSQL or SQLite)
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@localhost:5432/ezhuthaani

# Secret key for JWT auth signing (generate a strong random string for production)
JWT_SECRET=ezhuthaani-dev-secret-key-replace-in-production

# Allowed CORS origins (comma-separated list of origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Port
PORT=8000
